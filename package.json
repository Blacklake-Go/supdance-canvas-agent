{
  "name": "@supdance/canvas-agent",
  "version": "0.1.6",
  "license": "MIT",
  "description": "Local MCP and browser bridge for SupDance Canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blacklake-Go/supdance-canvas-agent.git"
  },
  "homepage": "https://github.com/Blacklake-Go/supdance-canvas-agent#readme",
  "bugs": "https://github.com/Blacklake-Go/supdance-canvas-agent/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "supdance-canvas-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "agent-instructions.md",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "debug": "tsx src/index.ts --debug",
    "test": "tsx --test src/config.test.ts src/open-canvas.test.ts src/server/http.acceptance.test.ts src/server/http.workbuddy.test.ts src/server/mcp.workbuddy.test.ts src/canvas/operations.test.ts src/canvas/session.test.ts src/agent/codex-client.test.ts src/agent/codex-history.test.ts src/agent/message-metadata.test.ts src/skills/store.test.ts src/utils/agent-runtime.test.ts",
    "check:workbuddy-package": "node scripts/check-workbuddy-package.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@openai/codex": "0.146.0",
    "express": "^5.1.0",
    "strip-ansi": "7.2.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
